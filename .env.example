# Railway PostgreSQL plugin provides this automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/krs

# Use a long random value, at least 32 characters.
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Optional: reservations work even when Telegram is not configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

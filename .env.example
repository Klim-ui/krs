# Railway PostgreSQL plugin provides this automatically.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/krs

# Use a long random value, at least 32 characters.
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Optional until the MAX bot passes moderation.
# Get the token in MAX Partner Platform → Chatbots → Advanced settings.
MAX_BOT_TOKEN=
# For personal notifications, get user_id from bot_started in GET /updates.
MAX_USER_ID=
# Optional alternative: group chat ID. MAX_USER_ID takes priority when both exist.
MAX_CHAT_ID=

# Optional. Defaults to 111980588 in code.
NEXT_PUBLIC_YANDEX_METRIKA_ID=111980588
